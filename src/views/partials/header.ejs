<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f4ec">
  <title><%= title %> · Trang nhật ký</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/"><span class="brand-mark">✳</span><span>trang nhật ký</span></a>
    <nav class="nav-links" aria-label="Điều hướng chính">
      <a href="/explore">Góc chia sẻ</a>
      <% if (currentUser) { %>
        <a href="/entries">Nhật ký của tôi</a>
        <span class="nav-greeting">Chào, <%= currentUser.displayName %></span>
        <form action="/auth/logout" method="post"><button class="nav-button" type="submit">Đăng xuất</button></form>
      <% } else { %>
        <a href="/auth/login">Đăng nhập</a>
        <a class="nav-signup" href="/auth/register">Tạo tài khoản</a>
      <% } %>
    </nav>
  </header>
  <main class="page-shell">
    <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
