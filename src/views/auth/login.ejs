<%- include('../partials/header') %>
<section class="auth-wrap">
  <div class="auth-note"><span class="scribble">Chào mừng<br>trở lại.</span><p>Những dòng chữ của bạn vẫn đang ở đây.</p></div>
  <form class="form-panel" action="/auth/login" method="post">
    <p class="eyebrow">Tiếp tục câu chuyện</p><h1>Đăng nhập</h1>
    <p class="form-intro">Mở lại cuốn nhật ký của bạn.</p>
    <% if (errors.length) { %><div class="form-errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %>
    <label>Email<input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"></label>
    <label>Mật khẩu<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="button button-primary button-wide" type="submit">Đăng nhập</button>
    <p class="form-switch">Chưa có tài khoản? <a href="/auth/register">Tạo tài khoản</a></p>
  </form>
</section>
<%- include('../partials/footer') %>
