<%- include('../partials/header') %>
<article class="reading-page">
  <a class="back-link" href="<%= publicPage ? '/explore' : '/entries' %>">← <%= publicPage ? 'Góc chia sẻ' : 'Nhật ký của tôi' %></a>
  <div class="reading-meta"><span class="privacy-tag <%= entry.visibility %>"><%= entry.visibility === 'public' ? 'Công khai' : 'Riêng tư' %></span><time><%= new Intl.DateTimeFormat('vi-VN', { dateStyle: 'long' }).format(entry.createdAt) %></time><% if (publicPage) { %><span>Viết bởi <%= entry.author.displayName %></span><% } %></div>
  <h1><%= entry.title %></h1>
  <div class="reading-content"><%= entry.content %></div>
  <% if (isOwner) { %><div class="reading-actions"><a class="button button-quiet" href="/entries/<%= entry.id %>/edit">Sửa bài viết</a><% if (!publicPage && entry.visibility === 'public') { %><a class="button button-quiet" href="/explore/<%= entry.id %>">Xem trang công khai</a><% } %></div><% } %>
</article>
<% if (publicPage) { %>
<section id="comments" class="comments-section">
  <div class="comments-heading"><h2>Góc trò chuyện</h2><span><%= comments.length %> bình luận</span></div>
  <% if (currentUser) { %>
    <form class="comment-form" action="/explore/<%= entry.id %>/comments" method="post">
      <% if (typeof commentErrors !== 'undefined' && commentErrors.length) { %><div class="form-errors"><% commentErrors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %>
      <label class="sr-only" for="comment-content">Viết bình luận</label><textarea id="comment-content" name="content" rows="3" maxlength="1000" placeholder="Viết một lời tử tế…" required></textarea><button class="button button-primary" type="submit">Gửi bình luận</button>
    </form>
  <% } else { %><p class="sign-in-note"><a href="/auth/login">Đăng nhập</a> để tham gia trò chuyện.</p><% } %>
  <% if (!comments.length) { %><p class="no-comments">Chưa có bình luận nào. Bạn có thể là người đầu tiên.</p><% } else { %>
    <div class="comment-list"><% comments.forEach(comment => { %><article class="comment"><div class="comment-avatar"><%= comment.author.displayName.slice(0, 1).toUpperCase() %></div><div class="comment-body"><div class="comment-by"><strong><%= comment.author.displayName %></strong><time><%= new Intl.DateTimeFormat('vi-VN', { dateStyle: 'medium' }).format(comment.createdAt) %></time></div><p><%= comment.content %></p></div><% if (currentUser && (String(comment.author.id) === String(currentUser.id) || isOwner)) { %><form action="/explore/<%= entry.id %>/comments/<%= comment.id %>?_method=DELETE" method="post"><button class="quiet-button" type="submit">Xóa</button></form><% } %></article><% }) %></div>
  <% } %>
</section>
<% } %>
<%- include('../partials/footer') %>
