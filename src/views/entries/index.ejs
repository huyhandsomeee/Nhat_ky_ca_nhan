<%- include('../partials/header') %>
<section class="page-heading split-heading">
  <div><p class="eyebrow">Góc của <%= currentUser.displayName %></p><h1>Nhật ký của tôi</h1><p class="lead">Những điều đã qua, được giữ lại bằng lời.</p></div>
  <a class="button button-primary" href="/entries/new">＋ Viết bài mới</a>
</section>
<form class="search-form" action="/entries" method="get"><label class="sr-only" for="entry-search">Tìm trong nhật ký của tôi</label><input id="entry-search" type="search" name="q" value="<%= search || '' %>" placeholder="Tìm trong nhật ký…"><button class="button button-quiet" type="submit">Tìm</button><% if (search) { %><a class="text-link" href="/entries">Xóa tìm kiếm</a><% } %></form>
<% if (!entries.length) { %>
  <section class="empty-state"><span class="empty-icon">✎</span><h2><%= search ? 'Không tìm thấy bài viết phù hợp' : 'Trang đầu tiên còn đang chờ' %></h2><p><%= search ? 'Thử từ khóa khác hoặc xóa bộ lọc.' : 'Hãy viết một điều nhỏ về hôm nay. Bài mới sẽ được giữ riêng tư.' %></p><% if (!search) { %><a class="text-link" href="/entries/new">Viết dòng đầu tiên</a><% } %></section>
<% } else { %>
  <section class="entry-list" aria-label="Các bài nhật ký">
    <% entries.forEach((entry, index) => { %>
      <article class="entry-row">
        <div class="entry-date"><span><%= new Intl.DateTimeFormat('vi-VN', { day: '2-digit' }).format(entry.createdAt) %></span><small><%= new Intl.DateTimeFormat('vi-VN', { month: 'short', year: 'numeric' }).format(entry.createdAt) %></small></div>
        <div class="entry-summary"><span class="privacy-tag <%= entry.visibility %>"><%= entry.visibility === 'public' ? 'Đang công khai' : 'Riêng tư' %></span><h2><a href="/entries/<%= entry.id %>"><%= entry.title %></a></h2><p><%= entry.content.slice(0, 180) %><%= entry.content.length > 180 ? '…' : '' %></p></div>
        <div class="entry-actions"><a href="/entries/<%= entry.id %>/edit">Sửa</a><form action="/entries/<%= entry.id %>?_method=DELETE" method="post"><button type="submit" class="quiet-button">Xóa</button></form></div>
      </article>
    <% }) %>
  </section>
<% } %>
<%- include('../partials/footer') %>
