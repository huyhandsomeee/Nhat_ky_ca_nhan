<%- include('../partials/header') %>
<section class="editor-wrap">
  <a href="/entries" class="back-link">← Nhật ký của tôi</a>
  <div class="editor-heading"><p class="eyebrow">Dành một chút thời gian cho mình</p><h1><%= heading %></h1><p>Không cần viết thật hay. Cứ viết thật lòng.</p></div>
  <form class="entry-form" action="<%= action %>" method="post">
    <% if (errors.length) { %><div class="form-errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %>
    <label for="title">Tiêu đề</label><input id="title" name="title" maxlength="120" value="<%= entry.title || '' %>" placeholder="Một câu ngắn để nhớ về ngày này" required>
    <label for="content">Bài viết</label><textarea id="content" name="content" rows="12" maxlength="10000" placeholder="Hôm nay mình đã…" required><%= entry.content || '' %></textarea>
    <div class="visibility-box"><div><strong>Ai có thể đọc bài này?</strong><small>Bài riêng tư chỉ bạn xem được. Bài công khai cho phép người khác bình luận.</small></div><select name="visibility" aria-label="Chế độ hiển thị"><option value="private" <%= entry.visibility !== 'public' ? 'selected' : '' %>>Chỉ mình tôi</option><option value="public" <%= entry.visibility === 'public' ? 'selected' : '' %>>Mọi người</option></select></div>
    <div class="form-actions"><a class="button button-quiet" href="/entries">Hủy</a><button class="button button-primary" type="submit">Lưu bài viết</button></div>
  </form>
</section>
<%- include('../partials/footer') %>
